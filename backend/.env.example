# Backend-only settings (root .env.example contains the full reference).
DATABASE_URL=postgresql+psycopg://salt:dss@localhost:5432/salt_pan_dss
# DATABASE_URL=sqlite:///./salt_pan_dss.db

AUTO_SEED=true
# auto (live w/ mock fallback) | live | mock | csv
WEATHER_PROVIDER=auto
# Real weather API key (environments only). Empty = run fully on mock weather.
WEATHER_API_KEY=
# Force the deterministic offline mock (true/false).
WEATHER_MOCK_MODE=false
# Optional historical-weather CSV path for provider=csv.
# WEATHER_CSV_PATH=../data/samples/weather_historical.csv
CORS_ORIGINS=http://localhost:3000
DEBUG=true

# --- Security / reliability ------------------------------------------
MAX_UPLOAD_MB=50
PHYSICAL_EQUIPMENT_CONTROL=false
ALLOW_AUTO_RETRAIN=true