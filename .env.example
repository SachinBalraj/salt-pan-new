# ------------------------------------------------------------------
# Salt Pan DSS - shared environment variables (copy to root .env and backend/.env)
# ------------------------------------------------------------------

# --- Database -------------------------------------------------------
# PostgreSQL (production / Docker):
DATABASE_URL=postgresql+psycopg://salt:dss@localhost:5432/salt_pan_dss
# Local no-Docker mode (SQLite fallback - uncomment to use):
# DATABASE_URL=sqlite:///./salt_pan_dss.db

# --- Application ----------------------------------------------------
APP_NAME=Salt Pan Decision Support System
ENVIRONMENT=development
# Seed demo data (generate samples + train models) when DB is empty on boot.
AUTO_SEED=true
DEBUG=true

# --- Paths ----------------------------------------------------------
# Relative to the backend working directory (backend/). Override if needed.
# DATA_DIR=../data
# MODELS_DIR=../models

# --- Weather --------------------------------------------------------
# auto = try live weather API and fall back to a deterministic mock,
# live  = require the real API (falls back to mock on outages),
# mock  = always use the built-in mock forecast generator,
# csv   = serve forecast-like days from a historical-weather CSV file.
WEATHER_PROVIDER=auto
# API key for the real weather API. Keep it in the environment, never in
# source code. Leave empty: the whole application still works on mock data.
WEATHER_API_KEY=
# Force the offline deterministic mock weather source (true/false).
WEATHER_MOCK_MODE=false
# Path to a historical weather CSV for the "csv" provider. Missing file
# gracefully falls back to mock continuation.
# WEATHER_CSV_PATH=../data/samples/weather_historical.csv
WEATHER_PROVIDER=auto
# Latitude/longitude used for live forecasts when a pan has no coordinates.
WEATHER_DEFAULT_LAT=19.17
WEATHER_DEFAULT_LON=74.73

# --- Dataset validation thresholds -----------------------------------
# Prototype logical-range config (see backend/app/config/domain_thresholds.yaml).
# Override the active thresholds file with a calibrated copy:
# DOMAIN_THRESHOLDS_FILE=../configs/my_calibrated.yaml

# --- Missing-label / proxy-label rules (Phase 5) ---------------------
# Prototype expert rules + provenance defaults for synthesised ML targets
# (see backend/app/config/proxy_labels.yaml and docs/proxy_label_methodology.md).
# Override the active proxy-label rules with a calibrated copy:
# PROXY_LABELS_CONFIG_FILE=../configs/my_proxy_labels.yaml

# --- CORS / frontend ------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Security / reliability ------------------------------------------
# Maximum upload file size in megabytes (default: 50 MB).
MAX_UPLOAD_MB=50
# Physical equipment control — MUST be false for prototype deployments.
# When true the system CAN send commands to real pumps/gates/valves.
PHYSICAL_EQUIPMENT_CONTROL=false
# Allow automatic retraining after feedback ingestion.
ALLOW_AUTO_RETRAIN=true